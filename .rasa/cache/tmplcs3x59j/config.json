{
  "prompt_template": null,
  "user_input": {
    "max_characters": 2000
  },
  "llm": {
    "id": "nebius_llm",
    "models": [
      {
        "type": "openai",
        "model": "Qwen/Qwen3-32B",
        "api_base": "https://api.tokenfactory.nebius.com/v1/",
        "api_key": "${NEBIUS_KEY}"
      }
    ]
  },
  "flow_retrieval": {
    "embeddings": {
      "id": "nebius_embeddings",
      "models": [
        {
          "type": "openai",
          "model": "Qwen/Qwen3-Embedding-8B",
